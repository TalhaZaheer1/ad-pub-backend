# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/adpub?schema=public"

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_super_secure_jwt_secret_change_this_in_production
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_change_this_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Bcrypt ───────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Seed ─────────────────────────────────────────────────
SEED_ADMIN_EMAIL=superadmin@adpub.com
SEED_ADMIN_PASSWORD=SuperAdmin@123
SEED_ADMIN_FIRST_NAME=Super
SEED_ADMIN_LAST_NAME=Admin
